# ==========================================
# SocietyOS — Environment Configuration
# ==========================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Persistence (Required)
MONGODB_URI=mongodb://localhost:27017/societyos
MONGODB_DB_NAME=societyos

# Authentication & Sessions (Better Auth)
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# Transactional Email (Resend — Optional in dev; falls back to console sink)
RESEND_API_KEY=
EMAIL_FROM=SocietyOS <notifications@societyos.local>

# Real-time Broadcast (Ably — Optional in dev; falls back to 5s HTTP polling)
ABLY_API_KEY=

# Secure CCTV Streaming Gateway (Optional; falls back to unconfigured state)
CAMERA_GATEWAY_URL=
CAMERA_GATEWAY_SECRET=

# Development Seed Mode (Restricted strictly to non-production environments)
ENABLE_DEMO_SEED=false
